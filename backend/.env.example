# Copy this file to .env and fill in the values. Never commit .env.

# Database. Postgres example:
#   postgresql://USER:PASSWORD@localhost:5432/pulsegrid
# For a quick local try with no database server, SQLite also works:
#   sqlite:///./fleet.db
DATABASE_URL=sqlite:///./fleet.db

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Google sign-in. Create an OAuth client at console.cloud.google.com and add
#   http://127.0.0.1:8000/auth/callback
# as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional settings (defaults shown).
# SESSION_SECRET_KEY=
# FRONTEND_URL=http://localhost:3000
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# OFFLINE_THRESHOLD_SECONDS=25
